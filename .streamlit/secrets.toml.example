# 이 파일을 secrets.toml 로 복사해서 값을 채우세요 (secrets.toml 은 git 에 올라가지 않아요).
# Streamlit Community Cloud 에서는 앱 Settings → Secrets 에 같은 형식으로 입력.

# 한국 업종 페이지 (pykrx · KRX 정보데이터시스템 로그인)
KRX_ID = ""
KRX_PW = ""

# 레짐 전략 페이지
FRED_API_KEY = ""     # https://fred.stlouisfed.org/docs/api/api_key.html
FG_KRX_AUTH_KEY = ""  # KRX 공공데이터 OpenAPI 인증키 (VKOSPI 자동 갱신용)
